[Unit]
Description=ASCHI BOT - ASCHEN EVENT ORGANIZER 24/7 Keep-Alive Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/aschi-bot
ExecStart=/opt/aschi-bot/venv/bin/python bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
EnvironmentFile=/opt/aschi-bot/.env

[Install]
WantedBy=multi-user.target
